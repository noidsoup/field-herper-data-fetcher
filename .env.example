# .env.example — template only. NEVER commit a real .env.
# Rule: secrets ONLY here (API keys, tokens, passwords). Behavioral config
# (timeouts, flags, thresholds) belongs in config files, not env vars.
#
# Every var the app reads MUST be listed here with a one-line purpose.
# A missing var should fail loudly at startup, not silently downstream.

# --- Local LanceDB project-knowledge index (agent tooling, not the app) ------
# Default store: <repo>/uncommitted/lancedb_project_knowledge (gitignored).
# Override to keep the index outside the repo:
# PROJECT_KNOWLEDGE_LANCEDB_DIR=~/.cache/<project>/lancedb-project-knowledge
# Extra repo-relative scan roots (comma-separated), e.g. a docs vault folder:
# PROJECT_KNOWLEDGE_LANCEDB_EXTRA_DIRS=wiki

# --- App secrets (examples — replace with the real vars this project needs) --
# API_KEY=
# DATABASE_URL=
